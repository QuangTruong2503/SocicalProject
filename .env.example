# ── Frontend (Vite) ────────────────────────────────────────────────────
# Everything prefixed VITE_ is embedded in the public JS bundle: never put a
# secret (OpenAI key, Supabase secret/service_role key) in a VITE_ variable.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
TURNSTILE_CAPTCHA_SITE_KEY=0x0000000000000000000000
# Optional: only if the image-name backend is hosted somewhere other than
# <VITE_SUPABASE_URL>/functions/v1/suggest-image-names
# VITE_IMAGE_NAME_API_URL=https://your-project-ref.supabase.co/functions/v1/suggest-image-names

# ── Server only: Supabase Edge Function "suggest-image-names" ─────────
# Not read by Vite. Set them as Edge Function secrets:
#   npx supabase secrets set --env-file supabase/functions/.env
# or copy them to supabase/functions/.env for `npx supabase functions serve`.
OPENAI_IMAGE_NAME_KEY=sk-proj-replace-me
# Optional (defaults shown)
OPENAI_IMAGE_NAME_MODEL=gpt-6-luna
OPENAI_IMAGE_NAME_REASONING_EFFORT=none
# Comma-separated list; empty = any origin (requests still need a signed-in user)
IMAGE_NAME_ALLOWED_ORIGINS=https://your-site.netlify.app,http://localhost:5173
# Usage ledger (docs/usage-logging.md). SUPABASE_URL and SUPABASE_SECRET_KEYS /
# SUPABASE_SERVICE_ROLE_KEY are provided by Supabase to hosted functions.
# A plain label for the key above, never the key itself:
OPENAI_IMAGE_NAME_KEY_ALIAS=image-naming-prod-v1
# production | staging | local
AI_USAGE_ENVIRONMENT=local
# Optional: long random string for request fingerprints (HMAC)
AI_USAGE_FINGERPRINT_SECRET=replace-with-a-long-random-string
