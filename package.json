{
  "name": "my-react-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:memory": "node --test src/utils/memoryGame.test.js tests/memoryGameDatabase.test.mjs",
    "test:memory:ui": "node --import ./tests/memoryGameLoader.mjs --test tests/memoryGameUI.test.mjs",
    "test:notifications": "node --test tests/notificationsDatabase.test.mjs && node --import ./tests/notificationsLoader.mjs --test tests/notificationsUI.test.mjs",
    "test:admin-quotations": "node --test src/utils/adminQuotations.test.js tests/adminQuotationsDatabase.test.mjs && node --import ./tests/adminQuotationsLoader.mjs --test tests/adminQuotationsUI.test.mjs",
    "test:admin-users": "node --test tests/adminUsersPlanDatabase.test.mjs",
    "test:file-convert": "node --test src/utils/fileConvert.test.js",
    "test:ai-image-names": "node --test src/utils/aiImageNaming.test.js tests/suggestImageNamesFunction.test.mjs tests/aiNamingAccessDatabase.test.mjs && node --import ./tests/aiRenameLoader.mjs --test tests/aiRenameUI.test.mjs",
    "test:usage": "node --test tests/usageLedgerDatabase.test.mjs tests/usageLedgerFunction.test.mjs tests/planModelAccessDatabase.test.mjs && node --import ./tests/aiRenameLoader.mjs --test tests/usageTelemetry.test.mjs tests/adminUsageUI.test.mjs",
    "test:avatar-frames": "node --test src/utils/avatarFrames.test.js src/utils/avatarUpload.test.js tests/avatarFramesDatabase.test.mjs tests/avatarFramesAnimatedDatabase.test.mjs tests/avatarFrameInspectFunction.test.mjs && node --import ./tests/avatarFramesLoader.mjs --test tests/avatarFramesUI.test.mjs tests/adminAvatarFramesUI.test.mjs",
    "test:admin-memory": "node --test src/utils/memoryCardAdmin.test.js tests/adminMemoryCardsDatabase.test.mjs && node --import ./tests/adminMemoryCardsLoader.mjs --test tests/adminMemoryCardsUI.test.mjs"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.6.1",
    "@supabase/supabase-js": "^2.105.3",
    "browser-image-compression": "^2.0.2",
    "dayjs": "^1.11.21",
    "framer-motion": "^12.42.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-dropzone": "^20.1.3",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.82.0",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.13.1",
    "react-to-print": "^3.3.0",
    "react-toastify": "^11.1.0",
    "uuid": "^14.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.1.1",
    "sass": "^1.99.0",
    "vite": "^8.0.1"
  }
}
